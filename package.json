{
  "name": "bilibili-downloader-client",
  "version": "1.3.0",
  "description": "哔哩下载器 · 客户端一体化版（内置代理）",
  "main": "main.js",
  "author": "Dom",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "smoke": "node scripts/smoke.cjs",
    "assets:android": "node scripts/sync-android.cjs",
    "dist:win": "npm run check && electron-builder --win",
    "pack:win": "npm run check && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.dom.bilidownloader",
    "productName": "哔哩下载器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "index.html",
      "app.js",
      "styles.css",
      "lame.min.js",
      "icon.ico",
      "package.json",
      "lib/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico",
      "artifactName": "BiliDownloader-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "哔哩下载器",
      "artifactName": "BiliDownloader-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BiliDownloader-${version}-portable.${ext}"
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg.LICENSE"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg.README"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "ffmpeg-static": "5.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
