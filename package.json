{
  "name": "bilibili-downloader-client",
  "version": "1.2.0",
  "description": "哔哩下载器 · 客户端一体化版（内置代理）",
  "main": "main.js",
  "author": "Dom",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "BILI_SMOKE_TEST=1 electron . --no-sandbox",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.dom.bilidownloader",
    "productName": "哔哩下载器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "index.html",
      "app.js",
      "styles.css",
      "lame.min.js",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico",
      "artifactName": "BiliDownloader-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "哔哩下载器",
      "artifactName": "BiliDownloader-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BiliDownloader-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}
